# Sakina Frontend — example environment file
# Copy to .env.local (Vite picks up .env.local automatically and gitignores it).
# Only variables prefixed with VITE_ are exposed to the client bundle.

# ── API base URL ────────────────────────────────────────────────────────────
# The FastAPI orchestrator's address. POST /chat is consumed by useChat (SSE).
VITE_API_URL=http://localhost:8001
