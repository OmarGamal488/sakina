# Sakina API — example environment file
# Copy to .env and fill in real values. Never commit .env.

# ── LLM (Lightning AI — OpenAI-compatible) ─────────────────────────────────
# https://lightning.ai/ — sign in, then create an API key under Settings.
# Used via the openai SDK:
#   from openai import OpenAI
#   client = OpenAI(base_url=LIGHTNING_BASE_URL, api_key=LIGHTNING_API_KEY)
#   client.chat.completions.create(model=LIGHTNING_MODEL, messages=[...])
LIGHTNING_BASE_URL=https://lightning.ai/api/v1/
LIGHTNING_API_KEY=
LIGHTNING_MODEL=lightning-ai/gpt-oss-120b

# ── Vector store (Qdrant Cloud) ─────────────────────────────────────────────
# https://cloud.qdrant.io — free tier is enough
# Collection name is hard-coded as `sakina_counseling` in app/rag/qdrant_client.py
QDRANT_URL=
QDRANT_API_KEY=

# ── Cache + conversation memory (Redis) ─────────────────────────────────────
# Stores per-session conversation turns + prior language + the RAG retrieval cache.
# Local docker: redis://localhost:6379/0
# Redis Cloud free tier: rediss://default:<password>@<host>:<port>
#
# IMPORTANT: if REDIS_URL is UNSET (or Redis is unreachable), the app falls back to
# an IN-PROCESS store — conversations are NOT persisted (lost on restart) and do NOT
# survive across workers. Set this + run Redis to get cross-reload/-device memory.
# Confirm which mode is live via the startup log: `memory_backend_active=redis|memory`.
REDIS_URL=redis://localhost:6379/0

# ── Hugging Face (optional) ─────────────────────────────────────────────────
# Only needed if you pull private/gated models. Public models work without it.
HF_TOKEN=

# ── App config ──────────────────────────────────────────────────────────────
# CORS — comma-separated origins the API will accept browsers from.
# Add your deployed GitHub Pages origin here for the rubric frontend, e.g.:
#   https://<your-user>.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-user.github.io

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Path to the Phase-1 artifacts directory (relative to the api/ folder).
ARTIFACTS_DIR=app/models/artifacts

# Groq — audio STT (https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_STT_MODEL=whisper-large-v3-turbo
